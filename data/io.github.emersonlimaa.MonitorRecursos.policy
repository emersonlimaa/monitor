<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Monitor de Recursos</vendor>
  <vendor_url>https://github.com/emersonlimaa/monitor</vendor_url>
  <icon_name>io.github.emersonlimaa.MonitorRecursos</icon_name>

  <action id="io.github.emersonlimaa.MonitorRecursos.manage">
    <description>Gerenciar programas e espaço em disco</description>
    <description xml:lang="pt_BR">Gerenciar programas e espaço em disco</description>
    <description xml:lang="en">Manage applications and disk space</description>
    <message>É preciso autenticar para desinstalar programas e liberar espaço no disco.</message>
    <message xml:lang="pt_BR">É preciso autenticar para desinstalar programas e liberar espaço no disco.</message>
    <message xml:lang="en">Authentication is required to uninstall applications and free disk space.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/monitor-recursos/monitor-recursos-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
